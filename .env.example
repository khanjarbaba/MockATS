# Copy to .env and fill in. Never commit .env.

# Base URL for the SHL endpoints you were given (no sandbox exists — these are real).
SHL_BASE_URL=https://api.shl.example.com

# Public URL of THIS mock (your ngrok/cloudflared tunnel). Injected as {{callback_url}}.
CALLBACK_BASE_URL=https://your-subdomain.ngrok-free.app

# SHL credentials — reference these from profile auth config by env var name.
SHL_API_KEY=
SHL_CLIENT_ID=
SHL_CLIENT_SECRET=
SHL_OAUTH_TOKEN_URL=
SHL_HMAC_SECRET=
SHL_WEBHOOK_SECRET=

# Safety: real sends are blocked unless this is "true" AND the request sets confirm=true.
ARMED=false

# If set, every page/API call requires HTTP Basic auth (any username, this password).
# Leave empty for local dev; REQUIRED for any hosted/shared deployment.
APP_PASSWORD=

# SQLite locally; on Render this is injected as a Postgres URL automatically.
DATABASE_URL=sqlite:///./mockats.db
